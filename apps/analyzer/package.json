{
  "name": "@flarex/source-analyzer-v2",
  "private": true,
  "type": "module",
  "exports": {
    "./internal/application-analysis-composition": "./src/ApplicationAnalysisComposition.ts",
    "./internal/system-test/declarative-v2-analyzer-port-v1": "./src/DeclarativeV2AnalyzerPort.ts",
    "./internal/system-test/declarative-v2-analyzer-restart-plan-v1": "./src/PrivateDeclarativeV2AnalyzerRestartPlan.ts",
