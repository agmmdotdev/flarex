{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flarex-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-14",
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "RegistryDO"
      },
      {
        "name": "DEPLOYMENTS",
        "class_name": "DeploymentDO"
      },
      {
        "name": "DEPLOYMENT_SYNCS",
        "class_name": "DeploymentSyncDO"
      },
      {
        "name": "PARTITIONS",
        "class_name": "PartitionDO"
      },
      {
        "name": "EXECUTIONS",
        "class_name": "ExecutionDO"
      },
      {
        "name": "CONNECTIONS",
        "class_name": "ConnectionDO"
      },
      {
        "name": "DELIVERIES",
        "class_name": "DeliveryDO"
      },
      {
        "name": "SCHEDULERS",
        "class_name": "SchedulerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistryDO",
        "DeploymentDO",
        "PartitionDO",
        "ExecutionDO",
        "ConnectionDO",
        "DeliveryDO",
        "SchedulerDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DeploymentSyncDO"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "flarex-artifacts"
    }
  ],
  "services": [
    {
      "binding": "FLAREX_ANALYZER",
      "service": "flarex-analyzer"
    },
    {
      "binding": "FLAREX_EXECUTOR",
      "service": "flarex-executor"
    },
    {
      "binding": "FLAREX_ARTIFACT_RUNTIME",
      "service": "flarex-artifact-runtime"
    }
  ],
  "vars": {
    "FLAREX_PROJECT_ID": "default",
    "FLAREX_ARTIFACT_RUNTIME_LOADS_SOURCE": "true"
  },
  "observability": {
    "enabled": true
  }
}
