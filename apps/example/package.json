{
  "name": "@flarex/example",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate && vite build --configLoader runner",
    "generate": "tsx scripts/generate.ts",
    "typecheck:generated": "tsx scripts/typecheck-generated.ts",
    "typecheck": "pnpm generate && tsc -p tsconfig.json",
    "test": "pnpm generate && vitest run"
  },
  "dependencies": {
    "flarex": "workspace:*"
  },
  "devDependencies": {
    "flarex-dev": "workspace:*",
    "flarex-test": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
