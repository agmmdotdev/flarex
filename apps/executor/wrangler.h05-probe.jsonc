{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flarex-executor-h05-probe",
  "main": "h05/probeWorker.ts",
  "compatibility_date": "2026-06-14",
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    {
      "binding": "FLAREX_EXECUTOR",
      "service": "flarex-executor"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
