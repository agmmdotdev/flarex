{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flarex-query-sync-fx02b-host-probe",
  "main": "src/hostWorker.ts",
  "compatibility_date": "2026-06-14",
  "workers_dev": true,
  "preview_urls": false,
  "define": {
    "FX02B_RELEASE_MARKER": "\"dry-run\""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEPLOYMENT_SYNCS",
        "class_name": "DeploymentSyncProbeDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeploymentSyncProbeDO"]
    }
  ],
  "services": [
    {
      "binding": "FLAREX_EXECUTOR",
      "service": "flarex-query-sync-fx02b-source-probe"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
