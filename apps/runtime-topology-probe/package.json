{
  "name": "@flarex/runtime-topology-probe",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck",
    "deploy:gateway:dry-run": "tsx scripts/runWranglerDryRun.ts gateway",
    "deploy:gateway:postgres:dry-run": "tsx scripts/runWranglerDryRun.ts gateway-postgres",
    "deploy:gateway:teardown:dry-run": "tsx scripts/runWranglerDryRun.ts gateway-teardown",
    "deploy:mock:dry-run": "tsx scripts/runWranglerDryRun.ts mock",
    "deploy:postgres:dry-run": "tsx scripts/runWranglerDryRun.ts postgres",
    "deploy:session-postgres:dry-run": "tsx scripts/runWranglerDryRun.ts session-postgres",
    "deploy:sync:dry-run": "tsx scripts/runWranglerDryRun.ts sync",
    "deploy:sync:teardown:dry-run": "tsx scripts/runWranglerDryRun.ts sync-teardown",
    "probe:abort": "tsx scripts/runProbeMatrix.ts abort",
    "probe:configure-token": "tsx scripts/configureProbeToken.ts",
    "probe:configure-session-postgres-token": "tsx scripts/configureProbeToken.ts session-postgres",
    "probe:cleanup-local-secrets": "tsx scripts/cleanupLocalProbeSecrets.ts",
    "probe:purge": "tsx scripts/runProbeMatrix.ts purge",
    "probe:run": "tsx scripts/runProbeMatrix.ts run",
    "probe:smoke": "tsx scripts/runProbeMatrix.ts smoke",
    "postgres:provision": "tsx scripts/provisionPostgresProbe.ts",
    "postgres:preflight": "tsx scripts/preflightPostgresProbe.ts",
    "session-postgres:provision": "tsx scripts/provisionPostgresProbe.ts session-postgres",
    "postgres:inspect": "tsx scripts/inspectPostgresProbe.ts",
    "postgres:teardown": "tsx scripts/teardownPostgresProbe.ts",
    "session-postgres:teardown": "tsx scripts/teardownPostgresProbe.ts session-postgres",
    "postgres:verify-absence": "tsx scripts/verifyPostgresProbeAbsence.ts",
    "teardown:gateway:delete:dry-run": "wrangler delete --dry-run --config wrangler.gateway.teardown.jsonc",
    "teardown:mock:delete:dry-run": "wrangler delete --dry-run --config wrangler.mock.jsonc",
    "teardown:postgres:delete:dry-run": "wrangler delete --dry-run --config wrangler.postgres.jsonc",
    "teardown:session-postgres:delete:dry-run": "wrangler delete --dry-run --config wrangler.session-postgres.teardown.jsonc",
    "teardown:sync:delete:dry-run": "wrangler delete --dry-run --config wrangler.sync.teardown.jsonc",
    "test": "vitest run --no-file-parallelism --test-timeout=20000",
    "test:local": "vitest run test/gateway.miniflare.test.ts test/runDO.miniflare.test.ts test/campaign.miniflare.test.ts test/purge.miniflare.test.ts test/runner.miniflare.test.ts test/runnerRecovery.miniflare.test.ts test/smoke.miniflare.test.ts --no-file-parallelism --test-timeout=180000 --hook-timeout=30000",
    "test:matrix": "vitest run test/runner.miniflare.test.ts --no-file-parallelism --test-timeout=180000 --hook-timeout=30000",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@flarex/utils": "workspace:*",
    "effect": "catalog:",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "miniflare": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
