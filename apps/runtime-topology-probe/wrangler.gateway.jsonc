{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flarex-runtime-topology-probe-gateway",
  "main": "src/gatewayWorker.ts",
  "compatibility_date": "2026-06-14",
  "workers_dev": true,
  "preview_urls": false,
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE_SESSIONS",
        "class_name": "ProbeSessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProbeSessionDO"]
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
