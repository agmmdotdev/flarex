{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flarex-runtime-topology-probe-gateway",
  "main": "src/gatewayWorker.ts",
  "compatibility_date": "2026-06-14",
  "workers_dev": true,
  "preview_urls": false,
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "services": [
    {
      "binding": "MOCK_READ",
      "service": "flarex-runtime-topology-probe-mock",
      "entrypoint": "MockReadEntrypoint"
    },
    {
      "binding": "MOCK_FINISH",
      "service": "flarex-runtime-topology-probe-mock",
      "entrypoint": "MockFinishEntrypoint"
    },
    {
      "binding": "MOCK_RERUN",
      "service": "flarex-runtime-topology-probe-mock",
      "entrypoint": "MockRerunEntrypoint"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE_SESSIONS",
        "class_name": "ProbeSessionDO"
      },
      {
        "name": "PROBE_RUNS",
        "class_name": "ProbeRunDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProbeSessionDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProbeRunDO"]
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
