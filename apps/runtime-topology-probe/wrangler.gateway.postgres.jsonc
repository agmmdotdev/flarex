{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flarex-runtime-topology-probe-gateway",
  "main": "src/gatewayPostgresWorker.ts",
  "compatibility_date": "2026-06-14",
  "workers_dev": true,
  "preview_urls": false,
  "worker_loaders": [{ "binding": "LOADER" }],
  "services": [
    {
      "binding": "SESSION_EXECUTOR_READ",
      "service": "flarex-runtime-topology-probe-gateway",
      "entrypoint": "ProbeSessionExecutorReadEntrypoint"
    },
    {
      "binding": "MOCK_READ",
      "service": "flarex-runtime-topology-probe-postgres",
      "entrypoint": "PostgresReadEntrypoint"
    },
    {
      "binding": "MOCK_FINISH",
      "service": "flarex-runtime-topology-probe-postgres",
      "entrypoint": "PostgresFinishEntrypoint"
    },
    {
      "binding": "MOCK_RERUN",
      "service": "flarex-runtime-topology-probe-mock",
      "entrypoint": "MockRerunEntrypoint"
    },
    {
      "binding": "MOCK_PURGE",
      "service": "flarex-runtime-topology-probe-mock",
      "entrypoint": "MockPurgeEntrypoint"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PROBE_SESSIONS", "class_name": "ProbeSessionDO" },
      {
        "name": "PROBE_SYNC",
        "class_name": "ProbeSyncDO",
        "script_name": "flarex-runtime-topology-probe-sync"
      },
      { "name": "PROBE_RUNS", "class_name": "ProbeRunDO" },
      { "name": "PROBE_CAMPAIGN", "class_name": "ProbeCampaignDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProbeSessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ProbeRunDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ProbeCampaignDO"] }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
