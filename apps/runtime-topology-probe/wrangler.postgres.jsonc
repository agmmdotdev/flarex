{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flarex-runtime-topology-probe-postgres",
  "main": "src/postgresCommitWorker.ts",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_CACHE_DISABLED",
      "id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE_SYNC",
        "class_name": "ProbeSyncDO",
        "script_name": "flarex-runtime-topology-probe-sync"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
