  "definitions": {
    "applicationActivation": "t=>t.startsWith('select \"scope_id\" , \"activation_sequence\"')&&t.includes('from \"fx_system_application_activation\"')",
    "legacySchema": "t=>t.startsWith('select \"scope_id\" , \"revision_id\"')&&t.includes('from \"fx_system_application_revision_schema_v1\"')",
    "selectedBindingBody": "t=>t.startsWith('select \"fx_system_data_binding_activation\"')&&t.includes('join \"fx_system_data_binding_candidate\"')",
    "fullClockKeyShare": "t=>t.startsWith('select \"scope_id\" , \"scope_uuid\"')&&t.includes('from \"fx_system_scope_clock\"')&&t.endsWith('for key share')",
    "revocationKeyShare": "t=>t.startsWith('select \"scope_id\" , \"authorization_revocation_epoch\"')&&t.endsWith('for key share')",
    "epochCapture": "t=>t.includes('from \"fx_system_prepared_metadata_epoch\" as epoch')&&!t.includes('nowait')",
    "epochTail": "t=>t.includes('from fx_lock_prepared_metadata_epoch ( ) as epoch')",
    "strongClock": "t=>t.startsWith('select \"scope_id\" , \"scope_uuid\"')&&t.includes('from \"fx_system_scope_clock\"')&&(/for (share|no key update)$/.test(t))",
    "physicalCatalog": "t=>t.includes('pg_index')&&t.includes('pg_am')"
  },
