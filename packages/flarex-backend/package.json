{
  "name": "flarex-backend",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "src",
    "test/backendHarness.ts",
    "test/lifecycleFixture.ts"
  ],
  "exports": {
    ".": "./src/worker.ts",
    "./artifact-runtime": "./src/artifactRuntime.ts",
    "./artifact-store": "./src/artifactStore.ts",
    "./internal/declarative-v2-authenticated-application-revision-evidence-v1": "./src/declarativeV2/AuthenticatedApplicationRevisionEvidence.ts",
    "./internal/declarative-v2-authenticated-command-reservation-preparation-v1": "./src/declarativeV2/AuthenticatedCommandReservationPreparation.ts",
    "./worker": "./src/worker.ts",
    "./types": "./src/types.ts",
    "./test/backendHarness": "./test/backendHarness.ts",
    "./test/lifecycleFixture": "./test/lifecycleFixture.ts",
    "./test/sync-protocol": "./src/syncProtocol.ts"
  },
  "scripts": {
    "build": "pnpm check:exact-runtime-core && pnpm check:point-mutation-runtime-kernel && tsc -p tsconfig.json",
    "check:exact-runtime-core": "tsx scripts/buildPointMutationExactRuntimeCore.ts check",
    "check:point-mutation-runtime-kernel": "tsx scripts/buildPointMutationRuntimeKernel.ts check",
    "exact-runtime-core:update": "tsx scripts/buildPointMutationExactRuntimeCore.ts update",
    "point-mutation-runtime-kernel:update": "tsx scripts/buildPointMutationRuntimeKernel.ts update",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@flarex/analysis": "workspace:*",
    "@flarex/executor-http": "workspace:*",
    "@flarex/function-runtime": "workspace:*",
    "@flarex/utils": "workspace:*",
    "effect": "catalog:",
    "flarex": "workspace:*",
    "flarex-protocol": "workspace:*"
  },
  "peerDependencies": {
    "miniflare": "catalog:",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "miniflare": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flarex/declarative-materializer": "workspace:*",
    "@flarex/declarative-program": "workspace:*",
    "@flarex/executor": "workspace:*",
    "@flarex/standard-application-definition": "workspace:*",
    "miniflare": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
