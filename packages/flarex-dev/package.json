{
  "name": "flarex-dev",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "flarex-dev": "./bin/flarex-dev.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./internal/managed-schema": "./src/managedSchema.ts",
    "./internal/retained-history-maintenance": "./src/retainedHistoryMaintenance.ts",
    "./internal/application-definition": "./src/applicationDefinition.ts",
    "./internal/application-source": "./src/applicationSource.ts",
    "./internal/local-node-task-executor": "./src/nodeTaskLocalExecutor/LocalNodeTaskExecutor.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node bin/flarex-dev.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@flarex/analysis": "workspace:*",
    "@flarex/application-definition": "workspace:*",
    "@flarex/durable-task": "workspace:*",
    "@flarex/executor": "workspace:*",
    "@flarex/executor-http": "workspace:*",
    "@flarex/freshness": "workspace:*",
    "@flarex/persistence-postgres": "workspace:*",
    "@flarex/standard-application-definition": "workspace:*",
    "@flarex/standard-application-registration": "workspace:*",
    "@flarex/utils": "workspace:*",
    "flarex": "workspace:*",
    "flarex-backend": "workspace:*",
    "flarex-protocol": "workspace:*",
    "effect": "catalog:",
    "miniflare": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0",
    "typescript": ">=5.0.0",
    "vite": "catalog:"
  }
}
