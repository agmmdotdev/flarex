{
  "name": "@flarex/medusa-adapter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./internal/currency-schema": "./src/modules/currency/schema.ts",
    "./internal/currency": "./src/modules/currency/service.ts",
    "./internal/product-schema": "./src/modules/product/schema.ts",
    "./internal/product-definition": "./src/modules/product/definition.ts",
    "./internal/product-attempt": "./src/modules/product/attempt.ts",
    "./internal/api-key": "./src/modules/api-key/service.ts",
    "./internal/api-key-schema": "./src/modules/api-key/schema.ts",
    "./internal/api-key/create-workflow": "./src/workflows/api-key/create.ts",
    "./internal/api-key/lifecycle": "./src/modules/api-key/lifecycle-service.ts",
    "./internal/api-key/update-workflow": "./src/workflows/api-key/update.ts",
    "./internal/api-key/revoke-workflow": "./src/workflows/api-key/revoke.ts",
    "./internal/api-key/delete-workflow": "./src/workflows/api-key/delete.ts",
    "./internal/api-key/deletion-links": "./src/links/api-key-deletion.ts",
    "./internal/api-key/association-workflow": "./src/workflows/api-key/associate-sales-channels.ts",
    "./internal/api-key/association-links": "./src/links/api-key-associations.ts",
    "./internal/api-key/sales-channel-read": "./src/modules/sales-channel/api-key-read.ts"
  },
  "dependencies": {
    "@flarex/durable-task": "workspace:*",
    "@flarex/analysis": "workspace:*",
    "@flarex/payload-adapter": "workspace:*",
    "@flarex/persistence-postgres": "workspace:*",
    "@flarex/utils": "workspace:*",
    "@medusajs/core-flows": "workspace:*",
    "@medusajs/currency": "workspace:*",
    "@medusajs/customer": "workspace:*",
    "@medusajs/deps": "workspace:*",
    "@medusajs/drizzle": "workspace:*",
    "@medusajs/fulfillment": "workspace:*",
    "@medusajs/locking": "workspace:*",
    "@medusajs/link-modules": "workspace:*",
    "@medusajs/modules-sdk": "workspace:*",
    "@medusajs/orchestration": "workspace:*",
    "@medusajs/pricing": "workspace:*",
    "@medusajs/product": "workspace:*",
    "@medusajs/sales-channel": "workspace:*",
    "@medusajs/store": "workspace:*",
    "@medusajs/tax": "workspace:*",
    "@medusajs/utils": "workspace:*",
    "@medusajs/workflows-sdk": "workspace:*",
    "effect": "catalog:",
    "flarex-protocol": "workspace:*",
    "@medusajs/inventory": "workspace:*",
    "@medusajs/stock-location": "workspace:*",
    "@medusajs/notification": "workspace:*",
    "@medusajs/notification-local": "workspace:*",
    "@medusajs/region": "workspace:*",
    "@medusajs/fulfillment-manual": "workspace:*",
    "@medusajs/order": "workspace:*",
    "@medusajs/payment": "workspace:*",
    "@medusajs/api-key": "workspace:*"
  },
  "devDependencies": {
    "@flarex/application-schema-definition": "workspace:*",
    "@medusajs/framework": "workspace:*",
    "@medusajs/test-utils": "workspace:*",
    "@medusajs/types": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-orm": "^0.45.2",
    "pg": "8.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.compatibility.json && tsc -p tsconfig.composite.json && tsc -p ../medusa-product/integration-tests/tsconfig.json && tsc -p ../medusa-sales-channel/integration-tests/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.compatibility.json && tsc -p tsconfig.composite.json && tsc -p ../medusa-product/integration-tests/tsconfig.json && tsc -p ../medusa-sales-channel/integration-tests/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:product:upstream": "vitest run --config vitest.product-upstream.config.ts",
    "test:sales-channel": "vitest run --config vitest.sales-channel.config.ts",
    "test:sales-channel:upstream": "vitest run --config vitest.sales-channel-upstream.config.ts"
  }
}
