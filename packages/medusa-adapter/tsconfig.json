{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.postgres.config.ts",
    "vitest.product-upstream.config.ts",
    "vitest.product-types.config.ts",
    "vitest.product-tags.config.ts",
    "vitest.product-collections.config.ts"
  ],
  "exclude": [
    "test/product-upstream.test.ts",
    "test/product-scale.test.ts",
    "test/currency-announcement.test.ts",
    "test/product-types-upstream.test.ts",
    "test/product-tags-upstream.test.ts",
    "test/product-collections-upstream.test.ts"
  ]
}
