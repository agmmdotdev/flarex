{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@models": [
        "../medusa-product/dist/models/index.d.ts"
      ],
      "@services": [
        "../medusa-product/dist/services/index.d.ts"
      ],
      "@types": [
        "../medusa-product/dist/types/index.d.ts"
      ],
      "@medusajs/test-utils": [
        "./test/support/runner-contract.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.store-request.config.ts",
    "vitest.fulfillment-delivery.config.ts",
    "vitest.native-stock-sales.config.ts",
    "vitest.native-api-key.config.ts",
    "vitest.native-cart-context.config.ts",
    "vitest.native-cart-creation.config.ts",
    "vitest.native-cart-payment-collection.config.ts",
    "vitest.native-checkout.config.ts",
    "vitest.native-payment-finance.config.ts",
    "vitest.native-payment-collections.config.ts",
    "vitest.native-shipping-profiles.config.ts",
    "vitest.native-shipping-option-types.config.ts",
    "vitest.native-service-zones.config.ts",
    "vitest.native-shipping-option-rules.config.ts",
    "vitest.native-shipping-option-creation.config.ts",
    "vitest.native-shipping-option-update.config.ts",
    "vitest.native-tax-region.config.ts",
    "vitest.native-order.config.ts",
    "vitest.postgres.config.ts",
    "vitest.sales-channel.config.ts",
    "vitest.sales-channel-upstream.config.ts",
    "vitest.product-upstream.config.ts",
    "vitest.product-failure.config.ts",
    "vitest.product-types.config.ts",
    "vitest.product-tags.config.ts",
    "vitest.product-collections.config.ts",
    "vitest.product-variants.config.ts",
    "vitest.product-categories.config.ts",
    "vitest.product-internal-categories.config.ts",
    "vitest.product-managed-read.config.ts",
    "vitest.product-internal.config.ts",
    "vitest.link-storage.config.ts"
  ],
  "exclude": [
    "test/product-tag-workflow.test.ts",
    "test/product-scale.test.ts",
    "test/currency-announcement.test.ts"
  ]
}
