{
  "name": "@medusajs/currency",
  "version": "2.13.4",
  "private": true,
  "exports": {
    "./index": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./static-manifest": {
      "types": "./dist/static-manifest.d.ts",
      "source": "./src/static-manifest.ts",
      "default": "./dist/static-manifest.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "source": "./src/models/index.ts",
      "default": "./dist/models/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "source": "./src/services/index.ts",
      "default": "./dist/services/index.js"
    },
    "./initial-data": {
      "types": "./dist/loaders/initial-data.d.ts",
      "source": "./src/loaders/initial-data.ts",
      "default": "./dist/loaders/initial-data.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@medusajs/framework": "workspace:*",
    "@medusajs/modules-sdk": "workspace:*",
    "@medusajs/types": "workspace:*",
    "@medusajs/utils": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
