{
  "name": "@medusajs/drizzle",
  "version": "2.13.4",
  "private": true,
  "exports": {
    "./schema": {
      "types": "./dist/schema.d.ts",
      "source": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./relation-query": {
      "types": "./dist/relation-query.d.ts",
      "source": "./src/relation-query.ts",
      "default": "./dist/relation-query.js"
    },
    "./mutation-events": {
      "types": "./dist/mutation-events.d.ts",
      "source": "./src/mutation-events.ts",
      "default": "./dist/mutation-events.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@medusajs/utils": "workspace:*"
  },
  "dependencies": {
    "@medusajs/types": "workspace:*"
  }
