{
  "name": "@medusajs/framework",
  "version": "2.13.4",
  "private": true,
  "exports": {
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "source": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    },
    "./modules-sdk/definition": {
      "types": "./dist/modules-sdk/definition.d.ts",
      "source": "./src/modules-sdk/definition.ts",
      "default": "./dist/modules-sdk/definition.js"
    },
    "./modules-sdk/module": {
      "types": "./dist/modules-sdk/module.d.ts",
      "source": "./src/modules-sdk/module.ts",
      "default": "./dist/modules-sdk/module.js"
    },
    "./awilix": {
      "types": "./dist/deps/awilix.d.ts",
      "source": "./src/deps/awilix.ts",
      "default": "./dist/deps/awilix.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "source": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./common/container": {
      "types": "./dist/common/container.d.ts",
      "source": "./src/common/container.ts",
      "default": "./dist/common/container.js"
    },
    "./defaults/currencies": {
      "types": "./dist/defaults/currencies.d.ts",
      "source": "./src/defaults/currencies.ts",
      "default": "./dist/defaults/currencies.js"
    },
    "./utils/portable": {
      "types": "./dist/utils/portable.d.ts",
      "source": "./src/utils/portable.ts",
      "default": "./dist/utils/portable.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "source": "./src/http/index.ts",
      "default": "./dist/http/index.js"
    },
    "./http/fetch": {
      "types": "./dist/http/fetch.d.ts",
      "source": "./src/http/fetch.ts",
      "default": "./dist/http/fetch.js"
    },
    "./http/static": {
      "types": "./dist/http/static.d.ts",
      "source": "./src/http/static.ts",
      "default": "./dist/http/static.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "source": "./src/zod/index.ts",
      "default": "./dist/zod/index.js"
    },
    "./build-tools/static-http-manifest": {
      "types": "./dist/build-tools/static-http-manifest.d.ts",
      "source": "./src/build-tools/static-http-manifest.ts",
      "default": "./dist/build-tools/static-http-manifest.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@medusajs/deps": "workspace:*",
    "@medusajs/types": "workspace:*",
    "@medusajs/utils": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
