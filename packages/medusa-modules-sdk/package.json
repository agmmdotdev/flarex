    ".": {
      "types": "./dist/definitions.d.ts",
      "source": "./src/definitions.ts",
      "default": "./dist/definitions.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@medusajs/types": "workspace:*",
    "@medusajs/utils": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
