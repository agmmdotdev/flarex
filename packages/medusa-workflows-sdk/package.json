{
  "name": "@medusajs/workflows-sdk",
  "version": "2.13.4",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/runtime.ts",
    "./testing/native-runtime": "./test/native-runtime-fixture.ts",
    "./durable": {
      "types": "./dist/durable/index.d.ts",
      "source": "./src/durable/index.ts",
      "default": "./dist/durable/index.js"
    },
    "./durable/engine": {
      "types": "./dist/durable/engine/index.d.ts",
      "source": "./src/durable/engine/index.ts",
      "default": "./dist/durable/engine/index.js"
    }
  },
  "dependencies": {
    "effect": "catalog:",
    "@medusajs/orchestration": "workspace:*",
    "@medusajs/types": "workspace:*",
    "@medusajs/utils": "workspace:*",
    "@medusajs/deps": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.durable.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.durable.json --noEmit"
  }
}
