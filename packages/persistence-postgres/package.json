{
  "name": "@flarex/persistence-postgres",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres.ts",
    "./pglite": "./src/pglite.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:postgres": "vitest run test/postgres.test.ts test/postgresConcurrency.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "flarex": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
