{
  "name": "medusa-cloudflare",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "audit:real-module-imports": "node ./scripts/audit-real-module-imports.mjs",
    "check:imports": "node ./scripts/check-portable-imports.mjs",
    "check:portable-entrypoints": "node ./scripts/check-portable-entrypoints.mjs",
    "check:real-module-imports": "node ./scripts/audit-real-module-imports.mjs --strict",
    "check:runtime-source-imports": "node ./scripts/check-runtime-source-imports.mjs",
    "dev": "vite",
    "dev:index-proof": "vite --config vite.index-proof.config.ts",
    "build:index-proof": "vite --config vite.index-proof.config.ts build",
    "prepare:http-proof-manifest": "pnpm --filter @medusajs/framework build",
    "generate:http-proof-manifest": "pnpm run prepare:http-proof-manifest && node ./scripts/generate-http-proof-manifest.mjs",
    "check:http-proof-manifest": "pnpm run prepare:http-proof-manifest && node ./scripts/generate-http-proof-manifest.mjs --check",
    "prepare:d1-migrations": "pnpm --filter @medusajs/currency build && pnpm --filter @medusajs/drizzle build",
    "generate:d1-migrations": "pnpm run prepare:d1-migrations && node ./scripts/generate-d1-migrations.mjs",
    "check:d1-migrations": "pnpm run prepare:d1-migrations && node ./scripts/generate-d1-migrations.mjs --check",
    "test": "vitest run ./src/worker.spec.ts ./src/cloudflare-http-request-scope.spec.ts",
    "test:d1-migrations": "node ./scripts/check-d1-migrations.mjs",
    "test:cart-do-sqlite": "node ./scripts/check-workerd-cart-do-sqlite.mjs",
    "test:do-sqlite": "node ./scripts/check-workerd-do-sqlite.mjs",
    "test:index-do-sqlite": "pnpm run test:index-sqlite",
    "test:index-sqlite": "node ./scripts/check-workerd-index-sqlite.mjs",
    "test:workerd": "node ./scripts/check-workerd-currency.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@medusajs/analytics": "workspace:*",
    "@medusajs/api-key": "workspace:*",
    "@medusajs/auth": "workspace:*",
    "@medusajs/caching": "workspace:*",
    "@medusajs/cart": "workspace:*",
    "@medusajs/cloudflare-runtime": "workspace:*",
    "@medusajs/currency": "workspace:*",
    "@medusajs/customer": "workspace:*",
    "@medusajs/deps": "workspace:*",
    "@medusajs/drizzle": "workspace:*",
    "@medusajs/drizzle-cloudflare": "workspace:*",
    "@medusajs/event-bus-cloudflare": "workspace:*",
    "@medusajs/event-bus-local": "workspace:*",
    "@medusajs/file": "workspace:*",
    "@medusajs/framework": "workspace:*",
    "@medusajs/fulfillment": "workspace:*",
    "@medusajs/index": "workspace:*",
    "@medusajs/inventory": "workspace:*",
    "@medusajs/locking": "workspace:*",
    "@medusajs/locking-cloudflare": "workspace:*",
    "@medusajs/modules-sdk": "workspace:*",
    "@medusajs/notification": "workspace:*",
    "@medusajs/order": "workspace:*",
    "@medusajs/payment": "workspace:*",
    "@medusajs/pricing": "workspace:*",
    "@medusajs/product": "workspace:*",
    "@medusajs/promotion": "workspace:*",
    "@medusajs/rbac": "workspace:*",
    "@medusajs/region": "workspace:*",
    "@medusajs/sales-channel": "workspace:*",
    "@medusajs/settings": "workspace:*",
    "@medusajs/stock-location": "workspace:*",
    "@medusajs/store": "workspace:*",
    "@medusajs/tax": "workspace:*",
    "@medusajs/translation": "workspace:*",
    "@medusajs/types": "workspace:*",
    "@medusajs/user": "workspace:*",
    "@medusajs/utils": "workspace:*",
    "@medusajs/workflow-engine-cloudflare": "workspace:*",
    "@medusajs/workflow-engine-inmemory": "workspace:*",
    "@medusajs/workflows-sdk": "workspace:*",
    "@noble/hashes": "^1.8.0",
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.1",
    "@cloudflare/workers-types": "^4.20260611.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.99.0"
  }
}
