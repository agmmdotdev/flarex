{
  "name": "@medusajs/orchestration",
  "version": "2.13.4",
  "description": "Medusa utilities to orchestrate modules",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./transaction": "./dist/transaction/index.js",
    "./transaction/errors": "./dist/transaction/errors.js",
