{
  "name": "@medusajs/event-bus-local",
  "version": "2.13.4",
  "description": "Local Event Bus Module for Medusa",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./static-manifest": {
      "types": "./dist/static-manifest.d.ts",
      "default": "./dist/static-manifest.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/medusajs/medusa",
    "directory": "packages/modules/event-bus-local"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Medusa",
  "license": "MIT",
  "devDependencies": {
    "@medusajs/framework": "workspace:*"
  },
  "scripts": {
    "watch": "tsc --build --watch",
    "build": "rimraf dist && tsc --build",
    "test": "jest --passWithNoTests --testPathPattern=src",
    "test:integration": "jest --passWithNoTests --no-cache --bail --detectOpenHandles --forceExit --logHeapUsage --testPathPattern=\"integration-tests/__tests__/.*\\.spec\\.ts\""
  },
  "peerDependencies": {
    "@medusajs/framework": "workspace:*"
  }
}
