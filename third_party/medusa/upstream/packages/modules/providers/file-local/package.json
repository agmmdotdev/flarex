{
  "name": "@medusajs/file-local",
  "version": "2.13.4",
  "description": "Local filesystem file storage for Medusa",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/medusajs/medusa",
    "directory": "packages/modules/providers/file-local"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Medusa",
  "license": "MIT",
  "scripts": {
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:jest": "jest --passWithNoTests --forceExit --testPathPattern=\"integration-tests/__tests__/[^/]*\\.spec\\.ts\"",
    "build": "rimraf dist && tsc --build ./tsconfig.json",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@medusajs/framework": "workspace:*",
    "@medusajs/utils": "workspace:*"
  },
  "peerDependencies": {
    "@medusajs/framework": "workspace:*"
  },
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-file"
  ]
}
